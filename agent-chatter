#!/usr/bin/env python3
"""Run agent-chatter from a git clone, without installing anything.

The implementation lives in chatter/cli.py, which is also what the installed
`agent-chatter` command runs. One code path for both, so a clone and an install
cannot behave differently.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from chatter.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
